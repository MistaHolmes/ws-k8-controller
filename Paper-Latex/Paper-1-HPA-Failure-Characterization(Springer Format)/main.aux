\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Statistical replication of Experiment B3 (5 runs). Peak connections reached 800 in all runs, while final connection counts exhibited consistent degradation due to scale-down events, averaging 18.8\% connection loss per run.}}{11}{table.1}\protected@file@percent }
\newlabel{tab:b3_replication}{{1}{11}{Statistical replication of Experiment B3 (5 runs). Peak connections reached 800 in all runs, while final connection counts exhibited consistent degradation due to scale-down events, averaging 18.8\% connection loss per run}{table.1}{}}
