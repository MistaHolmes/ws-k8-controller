\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Experiment B2-Instrumented multi-run averages. \textbf  {Left:} Reconnection rate (\texttt  {rate(new\_connections\_total[15s])}) showing peak observed average rates of 512~connections/second perfectly synchronized with scale-down events. \textbf  {Center:} Active connection count showing instability induced by simultaneous bursts, peaking at a mean of 767~($\pm $46). \textbf  {Right:} HPA replica changes, showing that each downward step causes the disruptions seen in the left and center panels.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:exp_b2_results}{{4}{9}{Experiment B2-Instrumented multi-run averages. \textbf {Left:} Reconnection rate (\texttt {rate(new\_connections\_total[15s])}) showing peak observed average rates of 512~connections/second perfectly synchronized with scale-down events. \textbf {Center:} Active connection count showing instability induced by simultaneous bursts, peaking at a mean of 767~($\pm $46). \textbf {Right:} HPA replica changes, showing that each downward step causes the disruptions seen in the left and center panels}{figure.4}{}}
