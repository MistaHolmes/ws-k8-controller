\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Results from Experiment A establishing a correct-behavior baseline. Under monotonic WebSocket load where CPU is artificially coupled to session count via continuous pinging, the clean staircase ascent, flat stabilization plateau, and controlled descent to the minimum demonstrate that HPA achieves the theoretical ideal only when signal-to-demand correlation is perfect.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:exp_a_replicas}{{2}{7}{Results from Experiment A establishing a correct-behavior baseline. Under monotonic WebSocket load where CPU is artificially coupled to session count via continuous pinging, the clean staircase ascent, flat stabilization plateau, and controlled descent to the minimum demonstrate that HPA achieves the theoretical ideal only when signal-to-demand correlation is perfect}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Results.}{7}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Experiment B2-Instrumented: Quantifying Reconnection Storm Intensity}{7}{subsection.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Methodological note.}{7}{section*.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Representative result from Experiment B1 demonstrating severe HPA over-provisioning and delayed recovery under cyclic load. HPA saturates at 10~replicas, a 233\% over-provision relative to the connection-derived optimum of 3~replicas, and requires $\sim $650~seconds to recover. Shaded bands show $\pm $1 SD across 3 replications.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:exp_b1_replicas}{{3}{8}{Representative result from Experiment B1 demonstrating severe HPA over-provisioning and delayed recovery under cyclic load. HPA saturates at 10~replicas, a 233\% over-provision relative to the connection-derived optimum of 3~replicas, and requires $\sim $650~seconds to recover. Shaded bands show $\pm $1 SD across 3 replications}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Hypothesis.}{8}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Experimental Setup.}{8}{section*.11}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Results.}{9}{section*.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Multi-run averages from Experiment B2-Instrumented demonstrating that HPA scale-down events directly trigger severe reconnection storms and connection instability. \textbf  {Left:} Reconnection rate showing peak observed average rates of 512~connections/second perfectly synchronized with scale-down events. \textbf  {Center:} Active connection count showing instability induced by simultaneous bursts, peaking at a mean of 767~($\pm $46). \textbf  {Right:} HPA replica changes, confirming that each downward step causes the corresponding session disruptions.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:exp_b2_results}{{4}{9}{Multi-run averages from Experiment B2-Instrumented demonstrating that HPA scale-down events directly trigger severe reconnection storms and connection instability. \textbf {Left:} Reconnection rate showing peak observed average rates of 512~connections/second perfectly synchronized with scale-down events. \textbf {Center:} Active connection count showing instability induced by simultaneous bursts, peaking at a mean of 767~($\pm $46). \textbf {Right:} HPA replica changes, confirming that each downward step causes the corresponding session disruptions}{figure.4}{}}
