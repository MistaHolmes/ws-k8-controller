\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Representative result from Experiment B3 showing staircase session destruction following successive HPA scale-down events. \textbf  {Left:} Active connection count exhibits permanent staircase destruction ($800{\rightarrow }771{\rightarrow }708{\rightarrow }644$). Connections are irrecoverable under \texttt  {reconnect: false}. \textbf  {Right:} Combined signal view demonstrating that as CPU utilization (red) drops to near zero due to idle connections, HPA scales down (green), causing the permanent destruction of active sessions (blue).}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:exp_b3_results}{{5}{11}{Representative result from Experiment B3 showing staircase session destruction following successive HPA scale-down events. \textbf {Left:} Active connection count exhibits permanent staircase destruction ($800{\rightarrow }771{\rightarrow }708{\rightarrow }644$). Connections are irrecoverable under \texttt {reconnect: false}. \textbf {Right:} Combined signal view demonstrating that as CPU utilization (red) drops to near zero due to idle connections, HPA scales down (green), causing the permanent destruction of active sessions (blue)}{figure.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Replication and Statistical Validation}{11}{section*.17}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Statistical replication of Experiment B3 (5 runs). Peak connections reached 800 in all runs, while final connection counts exhibited consistent degradation due to scale-down events, averaging 18.8\% connection loss per run.}}{12}{table.2}\protected@file@percent }
\newlabel{tab:b3_replication}{{2}{12}{Statistical replication of Experiment B3 (5 runs). Peak connections reached 800 in all runs, while final connection counts exhibited consistent degradation due to scale-down events, averaging 18.8\% connection loss per run}{table.2}{}}
