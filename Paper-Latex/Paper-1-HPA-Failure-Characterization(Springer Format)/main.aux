\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Experiment B3. \textbf  {Left:} Active connection count (representative Run~4) exhibits permanent staircase destruction ($800{\rightarrow }771{\rightarrow }708{\rightarrow }644$). Each step-down is perfectly synchronized with an HPA scale-down event. Connections are irrecoverable under \texttt  {reconnect: false}. \textbf  {Right:} Combined signal view. CPU utilization (red) drops to near zero as connections become idle, causing HPA to scale down (green), permanently destroying active connections (blue). The autoscaler's metric choice causes the destruction of the session state it intends to protect.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:exp_b3_results}{{5}{10}{Experiment B3. \textbf {Left:} Active connection count (representative Run~4) exhibits permanent staircase destruction ($800{\rightarrow }771{\rightarrow }708{\rightarrow }644$). Each step-down is perfectly synchronized with an HPA scale-down event. Connections are irrecoverable under \texttt {reconnect: false}. \textbf {Right:} Combined signal view. CPU utilization (red) drops to near zero as connections become idle, causing HPA to scale down (green), permanently destroying active connections (blue). The autoscaler's metric choice causes the destruction of the session state it intends to protect}{figure.5}{}}
