\newlabel{eq:websocket_reality}{{3}{9}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}The Stabilization Window Semantic Mismatch}{9}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Summary of the progressive evidence chain demonstrating the failure of CPU-based HPA for stateful WebSocket workloads. Each experiment isolates and quantifies a distinct failure mode.}}{10}{}\protected@file@percent }
\newlabel{tab:failure_summary}{{3}{10}{}{}{}}
