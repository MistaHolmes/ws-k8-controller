\@writefile{toc}{\contentsline {paragraph}{Results.}{10}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces HPA stabilization window tuning study results (3 replications per configuration). Gap relation indicates whether the idle gap duration was below or above the configured stabilization window. Connection loss is reported as mean $\pm $ SD across the three runs.}}{10}{}\protected@file@percent }
\newlabel{tab:tuning_results}{{4}{10}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Analysis.}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Connection loss percentage relative to the HPA stabilization window and gap duration. Green bars (``below'') show zero loss when the gap is shorter than the window; red bars (``above'') show consistent connection destruction when the gap exceeds the window, regardless of window size.}}{11}{}\protected@file@percent }
\newlabel{fig:tuning_results}{{9}{11}{}{}{}}
